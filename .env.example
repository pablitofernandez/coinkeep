# Global leaderboard (Supabase). Copy this file to .env and fill in your project's details:
# Supabase: the URL is https://<Project ID>.supabase.co (Project Settings → General, or Settings → Data API, or the "Connect" button).
# The key is the "publishable" one (sb_publishable_…, in Settings → API Keys) or the legacy "anon" one. Never the secret/service_role.
# Both are public by design (they end up in the published game); security comes from the rules in supabase/schema.sql.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_KEY=

# Only for downloading telemetry (npm run logs:pull): goes in .env.local, which is NOT committed.
# It's the secret key (sb_secret_…, Settings → API Keys): it grants full access, don't share it.
# SUPABASE_SECRET_KEY=
